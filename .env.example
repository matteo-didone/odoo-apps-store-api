# Copiare in .env e adattare. Tutte le variabili sono opzionali.

# --- upstream ---
ODOO_STORE_BASE_URL=https://apps.odoo.com
# Identificarsi con un contatto reale è buona educazione verso apps.odoo.com
ODOO_STORE_USER_AGENT=odoo-store-api/0.1 (+https://apps.odoo.com; contatto: tua@email.it)
ODOO_STORE_REQUEST_TIMEOUT=20

# --- rate limit verso lo store ---
ODOO_STORE_RATE_LIMIT_RPS=1.0
ODOO_STORE_MAX_CONCURRENCY=4
ODOO_STORE_MAX_RETRIES=3

# --- cache (secondi) ---
ODOO_STORE_TTL_LISTING=3600
ODOO_STORE_TTL_DETAIL=21600
ODOO_STORE_TTL_STATIC=86400
ODOO_STORE_TTL_NOT_FOUND=900

# --- persistenza ---
ODOO_STORE_DB_PATH=data/store.sqlite3

# --- sorgenti dei moduli ---
# Il codice arriva dal repository upstream, non dallo store: apps.odoo.com serve
# il download solo dietro reCAPTCHA e non è interrogabile da un client automatico.
ODOO_STORE_SOURCE_DIR=data/modules
ODOO_STORE_GITHUB_BASE_URL=https://codeload.github.com
# Facoltativo: alza il rate limit GitHub da 60 a 5000 richieste/ora.
# ODOO_STORE_GITHUB_TOKEN=ghp_...
ODOO_STORE_GITHUB_RATE_LIMIT_RPS=5.0
ODOO_STORE_GITHUB_TIMEOUT=60
# Tetti contro gli archivi ostili (tar-bomb).
ODOO_STORE_MAX_ARCHIVE_BYTES=67108864
ODOO_STORE_MAX_EXTRACTED_BYTES=268435456
ODOO_STORE_MAX_COMPRESSION_RATIO=120

# --- campionamento watchlist ---
ODOO_STORE_ENABLE_SCHEDULER=true
ODOO_STORE_SNAPSHOT_HOUR=3
ODOO_STORE_SNAPSHOT_MINUTE=0

# --- api ---
ODOO_STORE_CORS_ORIGINS=["*"]
ODOO_STORE_MAX_SEARCH_LIMIT=100
